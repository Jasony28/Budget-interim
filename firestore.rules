rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne peut lire et écrire QUE son propre budget
    match /budgets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Photos des factures / fiches de paie (sous-collection privée)
    match /budgets/{uid}/photos/{photoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
